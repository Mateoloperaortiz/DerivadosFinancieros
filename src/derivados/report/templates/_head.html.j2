<style>
/* Concepto: papel de valores. Portada con trama de guilloché (como un billete o un título valor), columna de
   lectura de ~70 caracteres y figuras a todo el ancho; tinta verde billete y un dorado de sello como acento. */
:root{
  --bg:#f4f6f5; --surface:#ffffff; --surface-2:#eef2f0; --sunken:#e8edea;
  --ink:#121c19; --ink-2:#44514c; --muted:#6f7b76; --line:#dde3e0; --line-2:#c3ccc8;
  --brand:#0b6b52; --brand-2:#0f8a68; --brand-tint:#e3f1eb;
  --gold:#8a6000; --gold-2:#d99f0b; --gold-tint:#faf1db;
  --blue:#2457a8; --blue-tint:#e8eefa; --verm:#b8391f; --verm-tint:#fbebe6;
  --hero:#e9f0ec; --guil-1:rgba(15,138,104,.30); --guil-2:rgba(201,140,0,.34);
  --hl:#fff3cf; --focus:#2f6fd1; --edge:rgba(18,28,25,.17);
  --f-display:"Bodoni Moda","Bodoni 72",Didot,"Times New Roman",serif;
  --f-sans:"IBM Plex Sans",system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
  --f-mono:"IBM Plex Mono",ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;
  --measure:70ch; --side:292px; --r:8px;
  color-scheme:light;
}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){
  --bg:#0d1210; --surface:#151b19; --surface-2:#1a2220; --sunken:#111715;
  --ink:#e7eeea; --ink-2:#b4c0bb; --muted:#87938e; --line:#26302d; --line-2:#36433f;
  --brand:#5cc9a2; --brand-2:#1f9f78; --brand-tint:#12271f;
  --gold:#e3b75a; --gold-2:#b28f17; --gold-tint:#272114;
  --blue:#8fb3f5; --blue-tint:#162034; --verm:#f0927b; --verm-tint:#2c1a16;
  --hero:#101a16; --guil-1:rgba(92,201,162,.26); --guil-2:rgba(227,183,90,.26);
  --hl:#2f2914; --focus:#8fb3f5; --edge:rgba(0,0,0,.6);
  color-scheme:dark;
}}
:root[data-theme="dark"]{
  --bg:#0d1210; --surface:#151b19; --surface-2:#1a2220; --sunken:#111715;
  --ink:#e7eeea; --ink-2:#b4c0bb; --muted:#87938e; --line:#26302d; --line-2:#36433f;
  --brand:#5cc9a2; --brand-2:#1f9f78; --brand-tint:#12271f;
  --gold:#e3b75a; --gold-2:#b28f17; --gold-tint:#272114;
  --blue:#8fb3f5; --blue-tint:#162034; --verm:#f0927b; --verm-tint:#2c1a16;
  --hero:#101a16; --guil-1:rgba(92,201,162,.26); --guil-2:rgba(227,183,90,.26);
  --hl:#2f2914; --focus:#8fb3f5; --edge:rgba(0,0,0,.6);
  color-scheme:dark;
}

*,*::before,*::after{box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:24px;-webkit-text-size-adjust:100%}
body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--f-sans);font-size:17px;line-height:1.66;
  font-feature-settings:"kern" 1;text-rendering:optimizeLegibility;-webkit-font-smoothing:antialiased}
::selection{background:var(--brand-tint);color:var(--ink)}
a{color:var(--brand);text-decoration-thickness:1px;text-underline-offset:3px}
a:hover{text-decoration-thickness:2px}
:focus-visible{outline:2px solid var(--focus);outline-offset:2px;border-radius:4px}
b,strong{font-weight:600;color:var(--ink)}
i,em{font-style:italic}
img,svg,canvas{max-width:100%}

/* ---------- barra de progreso de lectura */
.progress{position:fixed;inset:0 0 auto 0;height:2px;z-index:40;pointer-events:none}
.progress span{display:block;height:100%;width:100%;background:var(--brand-2);transform-origin:0 50%;transform:scaleX(0)}

/* ---------- navegación lateral */
.sidebar{position:fixed;top:0;left:0;bottom:0;width:var(--side);background:var(--surface);border-right:1px solid var(--line);
  padding:26px 18px 22px;overflow-y:auto;z-index:30;display:flex;flex-direction:column;gap:18px;scrollbar-width:thin}
.brand{display:grid;grid-template-columns:44px 1fr;gap:12px;align-items:center;text-decoration:none;color:inherit;padding:0 6px}
.brand canvas{width:44px;height:44px;display:block}
.brand-t{display:block;font-family:var(--f-display);font-size:19px;font-weight:600;line-height:1.12;color:var(--ink);font-variation-settings:"opsz" 11;
  text-wrap:balance}
.brand-sub{display:block;font-size:12.5px;line-height:1.35;color:var(--muted);margin-top:3px}
.parts{display:grid;grid-template-columns:1fr 1fr;gap:3px;padding:3px;background:var(--sunken);border-radius:10px}
.parts a{display:block;text-align:center;padding:7px 6px;border-radius:7px;font-size:12.5px;font-weight:500;color:var(--ink-2);
  text-decoration:none;line-height:1.25}
.parts a small{display:block;font-family:var(--f-mono);font-size:10.5px;letter-spacing:.06em;text-transform:uppercase;color:var(--muted)}
.parts a:hover{color:var(--ink)}
.parts a.on{background:var(--surface);color:var(--ink);box-shadow:0 1px 2px rgba(0,0,0,.08),0 0 0 1px var(--line)}
.parts a.on small{color:var(--brand)}
.toc{display:flex;flex-direction:column;gap:1px}
.toc a{display:grid;grid-template-columns:34px 1fr;gap:4px;align-items:baseline;color:var(--ink-2);text-decoration:none;
  padding:6px 8px;border-radius:6px;font-size:13.5px;line-height:1.35}
.toc a .code{font-family:var(--f-mono);font-size:11px;color:var(--muted);letter-spacing:.02em}
.toc a:hover{background:var(--surface-2);color:var(--ink)}
.toc a.on{background:var(--brand-tint);color:var(--ink)}
.toc a.on .code{color:var(--brand);font-weight:600}
.toc .grp{margin:18px 8px 4px;font-size:11px;font-weight:600;letter-spacing:.07em;text-transform:uppercase;color:var(--muted);line-height:1.35}
.toc .grp:first-child{margin-top:4px}
.stamp{margin-top:auto;font-family:var(--f-mono);font-size:11px;line-height:1.7;color:var(--muted);border-top:1px solid var(--line);
  padding:14px 8px 0}
.stamp b{color:var(--ink-2);font-weight:500}
.theme-switch{display:grid;grid-template-columns:repeat(3,1fr);gap:3px;padding:3px;background:var(--sunken);border-radius:9px}
.theme-switch button{font:inherit;font-size:12px;border:0;background:transparent;color:var(--ink-2);padding:6px 4px;border-radius:6px;cursor:pointer}
.theme-switch button[aria-pressed="true"]{background:var(--surface);color:var(--ink);box-shadow:0 0 0 1px var(--line)}

.topbar{display:none}
.scrim{display:none}

main{margin-left:var(--side);min-width:0}
.wrap{max-width:1128px;margin:0 auto;padding-inline:max(40px,env(safe-area-inset-right,0px))}

/* ---------- portada */
.hero{position:relative;overflow:hidden;background:var(--hero);border-bottom:1px solid var(--line);padding-block:44px 40px;isolation:isolate}
.hero canvas.guilloche{position:absolute;inset:0;width:100%;height:100%;z-index:-1;pointer-events:none}
.hero .wrap{position:relative}
.part-switch{display:flex;margin-bottom:22px}
.part-switch a{font-size:13px;font-weight:500;line-height:1.45;text-decoration:none;color:var(--ink-2);background:var(--surface);border:1px solid var(--line);
  padding:5px 13px;border-radius:16px;text-wrap:balance}
.part-switch a:hover{color:var(--ink);border-color:var(--line-2)}
.eyebrow{font-family:var(--f-mono);font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--brand);font-weight:500}
.hero h1{font-family:var(--f-display);font-weight:600;font-size:clamp(32px,4.1vw,52px);line-height:1.06;letter-spacing:-.012em;
  margin:14px 0 18px;max-width:min(900px,100%);text-wrap:balance;color:var(--ink);font-variation-settings:"opsz" 34}
.hero .lead{font-size:18.5px;line-height:1.6;color:var(--ink-2);max-width:var(--measure);margin:0 0 24px}
.meta{display:flex;flex-wrap:wrap;gap:10px 36px;font-size:14px;color:var(--ink);margin-bottom:30px}
.meta > div > span:first-child{display:block;font-family:var(--f-mono);font-size:10.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--muted)}
.ticket{background:var(--surface);border:1px solid var(--line-2);border-radius:10px;overflow:hidden;
  box-shadow:0 1px 0 rgba(255,255,255,.4) inset,0 18px 40px -28px rgba(10,40,30,.35)}
.ticket-head{display:flex;flex-wrap:wrap;justify-content:space-between;gap:4px 16px;padding:10px 18px;border-bottom:1px dashed var(--line-2);
  font-family:var(--f-mono);font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--muted)}
.ticket-head b{color:var(--ink);font-weight:600}
.kpis{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--line)}
.kpi{background:var(--surface);padding:15px 18px 16px;min-width:0}
.kpi .l{font-family:var(--f-mono);font-size:10.5px;letter-spacing:.09em;text-transform:uppercase;color:var(--muted);line-height:1.4}
.kpi .v{font-size:23px;font-weight:600;color:var(--ink);margin:6px 0 2px;line-height:1.15;letter-spacing:-.01em}
.kpi .s{font-size:12.5px;color:var(--ink-2);line-height:1.45}
/* Pesos del portafolio: cada cifra con su ticker encima, en el color con que ese ticker sale en las gráficas. */
.kpi .wts{display:flex;flex-wrap:wrap;column-gap:.85em;row-gap:4px}
/* Con la ficha en tres columnas (pantallas de 1181 a ~1420 px) las tres cifras no caben a 23 px: la letra se ajusta al
   ancho de la tarjeta (cqi) para que vayan en un solo renglón. */
.kpi:has(> .wts){container-type:inline-size}
@supports (font-size:1cqi){.kpi .v.wts{font-size:min(23px,7.4cqi)}}
.kpi .wts > span{white-space:nowrap}
.kpi .wts small{display:block;font-family:var(--f-mono);font-size:10.5px;font-weight:600;letter-spacing:.08em;line-height:1.3;margin-bottom:1px}
.kpi .wts .t-msft{color:var(--blue)}
.kpi .wts .t-wmt{color:var(--gold)}
.kpi .wts .t-xom{color:var(--verm)}
/* Lista con separador que nunca cuelga (antetítulo, integrantes, ficha): cada pieza pasa entera al renglón siguiente y
   el «·» vive en el hueco a su izquierda; el de la pieza que abre renglón cae fuera de la caja y se recorta. El hueco
   (--slg) mide lo mismo que « · » con la letra de cada sitio. */
.sl{display:flex;flex-wrap:wrap;column-gap:var(--slg,.8em);overflow:hidden}
.sl > *{position:relative;min-width:0}
.sl > * + *::before{content:"·";position:absolute;top:0;right:100%;width:var(--slg,.8em);text-align:center}
.sl.slash > * + *::before{content:"/"}
.sl.slash{--slg:.86em}
.eyebrow.sl{--slg:2.16em}
.ticket-head .sl{--slg:2.1em}
/* En la ficha, el rótulo (mono, con su espaciado) y la cifra también pueden partirse: « / » mide 2,07 em y 0,88 em. */
.kpi .l.sl{--slg:2.07em}
.kpi .v.sl{--slg:.88em}

/* ---------- secciones y texto */
section{padding:56px 0 8px}
section + section{border-top:1px solid var(--line)}
section#resumen{border-top:0}
.part-label{display:inline-flex;align-items:center;gap:8px;font-family:var(--f-mono);font-size:11.5px;letter-spacing:.12em;
  text-transform:uppercase;color:var(--brand);font-weight:500}
.part-label::before{content:"";width:7px;height:7px;border-radius:50%;background:var(--gold-2)}
h2{font-family:var(--f-display);font-weight:600;font-size:clamp(27px,2.7vw,36px);line-height:1.14;letter-spacing:-.01em;
  margin:12px 0 14px;color:var(--ink);text-wrap:balance;max-width:min(860px,100%);font-variation-settings:"opsz" 22}
h2 .num{font-style:italic;font-weight:500;color:var(--gold);margin-right:.32em}
h3{font-size:21px;font-weight:600;line-height:1.3;letter-spacing:-.005em;margin:40px 0 10px;color:var(--ink);text-wrap:balance;max-width:var(--measure)}
h4{font-size:16.5px;font-weight:600;line-height:1.35;margin:22px 0 6px;color:var(--ink)}
p{margin:12px 0}
section > p,section > ul,section > ol,section > h3,section > h4,.card > p,.card > h4,.card > ul,.card > ol{max-width:var(--measure)}
.intro{font-size:19px;line-height:1.6;color:var(--ink-2)}
/* Nota al margen: un apunte que acompaña a una tabla o cierra un tramo, más chico que el cuerpo. */
.note{font-size:14.5px;line-height:1.6;color:var(--ink-2);max-width:var(--measure);margin:16px 0;padding-left:14px;border-left:2px solid var(--gold-2)}
.note b{color:var(--ink)}
/* Símbolos que no deben pasar a mayúsculas en rótulos versalitas (σ, β, VaR). */
.nc{text-transform:none;letter-spacing:.02em}
sub,sup{font-size:.74em;line-height:0;position:relative;vertical-align:baseline}
sub{bottom:-.24em}
sup{top:-.48em}
ul,ol{padding-left:1.25em}
li{margin:6px 0}
li::marker{color:var(--muted)}
ul.tight li{margin:7px 0}
code{font-family:var(--f-mono);font-size:.88em;background:var(--sunken);padding:1px 5px;border-radius:4px}

.card{background:var(--surface);border:1px solid var(--line);border-radius:var(--r);padding:20px 24px;margin:20px 0;min-width:0}
.card > :first-child{margin-top:0}
.card h4{margin-top:0;font-family:var(--f-display);font-size:21px;font-weight:600;font-variation-settings:"opsz" 12}
.card ul{margin-bottom:0}
/* Una tarjeta suelta de puro texto se ciñe a la columna de lectura (no deja una franja vacía a la derecha). */
section > .card{max-width:calc(var(--measure) + 50px)}
.grid2{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px;margin:20px 0}
.grid3{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px;margin:20px 0}
.grid2 > .card,.grid2 > .fig,.grid2 > .callout,.grid3 > .card,.grid3 > .fig{margin:0}
/* En cada celda, lo primero arranca arriba y lo último no empuja: así los bordes de tabla y gráfica quedan alineados.
   El rótulo de un recuadro (.t) nunca es «lo último» aunque el cuerpo sea texto suelto: conserva su aire. */
.grid2 > div > :first-child,.grid3 > div > :first-child{margin-top:0}
.grid2 > div > :last-child:not(.t),.grid3 > div > :last-child:not(.t){margin-bottom:0}
.mini{background:var(--surface);border:1px solid var(--line);border-radius:var(--r);padding:14px 16px;min-width:0}
.mini .l{font-family:var(--f-mono);font-size:10.5px;letter-spacing:.09em;text-transform:uppercase;color:var(--muted);line-height:1.4}
.mini .v{font-size:22px;font-weight:600;color:var(--ink);margin:6px 0 2px;line-height:1.2;letter-spacing:-.01em}
.mini .s{font-size:13px;color:var(--ink-2);line-height:1.45}

.callout{position:relative;background:var(--gold-tint);border-radius:var(--r);padding:16px 22px 16px;margin:24px 0;color:var(--ink);
  max-width:calc(var(--measure) + 44px)}
.callout.blue{background:var(--blue-tint)}
.callout.green{background:var(--brand-tint)}
.callout.red{background:var(--verm-tint)}
/* Rótulo con rombo colgado: si el título se parte, el rombo queda en el primer renglón y el texto alineado. */
.callout .t{display:block;position:relative;padding-left:16px;font-family:var(--f-mono);font-size:11.5px;line-height:1.55;letter-spacing:.1em;
  text-transform:uppercase;color:var(--gold);font-weight:600;margin-bottom:6px;text-wrap:balance}
.callout .t::before{content:"";position:absolute;left:0;top:calc(.775em - 3.5px);width:7px;height:7px;transform:rotate(45deg);background:currentColor}
.callout.blue .t{color:var(--blue)}
.callout.green .t{color:var(--brand)}
.callout.red .t{color:var(--verm)}
.callout ol,.callout ul{max-width:none}

/* Bloque de fórmulas: cada $$…$$ es una pieza; en escritorio van en fila y en el celular se apilan. Si aun así algo
   no cabe, la sombra del borde (fondos «local» sobre fondos «scroll») avisa que la caja se desplaza. */
.formula{display:flex;flex-wrap:wrap;align-items:center;justify-content:center;justify-content:safe center;column-gap:2.4em;
  border:1px solid var(--line);border-radius:var(--r);padding:8px 18px;margin:16px 0;overflow-x:auto;overscroll-behavior-x:contain;
  background:
    linear-gradient(90deg,var(--surface) 35%,transparent) left center/32px 100% no-repeat local,
    linear-gradient(270deg,var(--surface) 35%,transparent) right center/32px 100% no-repeat local,
    radial-gradient(farthest-side at 0 50%,var(--edge),transparent) left center/12px 100% no-repeat scroll,
    radial-gradient(farthest-side at 100% 50%,var(--edge),transparent) right center/12px 100% no-repeat scroll,
    var(--surface)}
.formula > .katex-display{margin:.6em 0;flex:none}
.formula .f-word{font-size:15px;font-style:italic;color:var(--ink-2)}
/* Una fórmula en línea no se parte a media expresión (un corchete abierto al final del renglón): pasa entera al
   siguiente. Solo la que no cabe ni en un renglón completo de su párrafo vuelve a partirse donde KaTeX lo permite
   (el JS le pone .kwrap). */
.katex{font-size:1.06em;white-space:nowrap}
.katex.kwrap{white-space:normal}
@media (max-width:360px){.katex{font-size:1em}}
.katex-display{margin:.8em 0}

/* ---------- tablas
   .table-wrap enmarca y .tscroll es lo único que se desplaza: la nota (.tnote) queda quieta debajo. El JS marca en
   .tscroll lo que queda por ver (.ml columnas a la izquierda, .mr a la derecha, .mb filas abajo) y aquí se funde ese
   borde con el papel. La máscara queda por encima de todo lo de adentro (filas teñidas, encabezado y pie fijos), cosa
   que una sombra de fondo no logra; si la tabla cabe entera no hay clase ni fundido. */
.table-wrap{margin:18px 0;border:1px solid var(--line);border-radius:var(--r);background:var(--surface);overflow:hidden;min-width:0;
  display:grid;grid-template-columns:minmax(0,1fr)}
.tscroll{overflow-x:auto;overscroll-behavior-x:contain;background:var(--surface);grid-area:1/1}
/* El fundido no llega a transparente: una columna cortada en el borde se sigue viendo cortada. */
.tscroll.ml{--ml:rgba(0,0,0,.25)}
.tscroll.mr{--mr:rgba(0,0,0,.25)}
/* Pista de que hay más columnas: una sombra en el borde, como la de las fórmulas. Va en el marco, fuera de la máscara,
   y comparte con .tscroll la primera celda de la rejilla, así que mide lo mismo que la tabla y no baja hasta la nota. */
.table-wrap::before,.table-wrap::after{content:"";grid-area:1/1;width:12px;z-index:3;pointer-events:none;opacity:0;
  transition:opacity .15s}
.table-wrap::before{justify-self:start;background:linear-gradient(90deg,var(--edge),transparent)}
.table-wrap::after{justify-self:end;background:linear-gradient(270deg,var(--edge),transparent)}
.table-wrap:has(> .tscroll.ml)::before,.table-wrap:has(> .tscroll.mr)::after{opacity:1}
/* Sin fila Σ fija, el borde inferior se funde igual que los laterales (con ella, ver tfoot td::before más abajo). */
.tscroll.mb:not(:has(> table > tfoot)){--mb:transparent}
.tscroll.ml,.tscroll.mr,.tscroll.mb:not(:has(> table > tfoot)){
  -webkit-mask-image:linear-gradient(90deg,var(--ml,#000),#000 36px,#000 calc(100% - 36px),var(--mr,#000)),
    linear-gradient(0deg,var(--mb,#000),#000 44px);
  mask-image:linear-gradient(90deg,var(--ml,#000),#000 36px,#000 calc(100% - 36px),var(--mr,#000)),
    linear-gradient(0deg,var(--mb,#000),#000 44px);
  -webkit-mask-composite:source-in;mask-composite:intersect}
/* La máscara recortaría el anillo de foco: se dibuja en el marco. */
@supports selector(:has(*)){
  .tscroll:focus-visible{outline:none}
  .table-wrap:has(> .tscroll:focus-visible){outline:2px solid var(--focus);outline-offset:2px}
}
/* Alto fijo de referencia; el JS lo ajusta unos píxeles para que el borde inferior corte una fila por la mitad. */
.tscroll.vs{--vs-h:540px;max-height:var(--vs-h);overflow:auto;overscroll-behavior:contain}
.tscroll.vs thead th{position:sticky;top:0;z-index:2;border-bottom:0;box-shadow:inset 0 -1px 0 var(--line-2)}
.tscroll.vs tfoot td{position:sticky;bottom:0;z-index:2;border-top:0;box-shadow:inset 0 1px 0 var(--line-2)}
/* Mientras queden filas abajo, las últimas visibles se desvanecen justo encima de la fila Σ fija. */
.tscroll.vs tfoot td::before{content:"";position:absolute;left:0;right:0;bottom:100%;height:44px;pointer-events:none;
  background:linear-gradient(to top,var(--surface),transparent);opacity:0;transition:opacity .15s}
.tscroll.vs.mb tfoot td::before{opacity:1}
table.data{border-collapse:collapse;width:100%;min-width:var(--tw,0);font-size:13.5px;line-height:1.45;font-variant-numeric:tabular-nums}
@media (max-width:760px){table.data{min-width:calc(var(--tw,0px) * 1.1)}}
table.data th{background:var(--surface-2);color:var(--ink-2);font-weight:600;font-size:12px;letter-spacing:.01em;padding:10px 12px;
  vertical-align:bottom;border-bottom:1px solid var(--line-2);line-height:1.3;text-align:left}
/* Cabecera de dos niveles: la raya del grupo va en el <span>, recortada por el relleno de la celda, para que dos grupos
   vecinos no se lean como una sola raya. */
table.data th.gh{border-bottom:0;padding-bottom:0}
table.data th.gh > span{display:block;padding-bottom:5px;border-bottom:1px solid var(--line-2)}
table.data td{padding:9px 12px;border-top:1px solid var(--line);vertical-align:top;color:var(--ink)}
table.data .ar{text-align:right}
table.data .ac{text-align:center}
table.data tbody tr:first-child td{border-top:0}
table.data tbody tr:hover td{background:var(--surface-2)}
table.data tr.hl td{background:var(--hl);font-weight:500}
table.data tr.hg td{background:var(--brand-tint)}
table.data tr.t0 td{background:var(--sunken)}
table.data tr.sep td,table.data tr.sub td{border-top:1px solid var(--line-2)}
/* Rótulo de grupo (escenario, innovación) a todo el ancho: evita repetir el nombre en una columna angosta. */
table.data tr.grp td{padding-top:13px;padding-bottom:5px;border-top:1px solid var(--line-2);font-size:11px;font-weight:600;
  letter-spacing:.08em;text-transform:uppercase;color:var(--brand);white-space:normal}
table.data tbody tr.grp:hover td{background:none}
table.data tbody tr.grp.hl td{background:var(--hl);color:var(--gold)}
table.data tbody tr.grp:first-child td{border-top:0}
table.data tr.grp + tr td{border-top:0}
table.data tfoot td{background:var(--surface-2);font-weight:600;border-top:1px solid var(--line-2)}
table.data sub{font-size:.78em;line-height:0}
table.compact td,table.compact th{padding:7px 10px;font-size:12.8px}
table.dense td,table.dense th{padding-left:8px;padding-right:8px}
@media (max-width:760px){table.dense td{white-space:nowrap}}
table.kv td:first-child{font-weight:600;color:var(--ink-2);width:30%;font-size:13px}
/* Tabla angosta: se ciñe el marco (o la tarjeta de la figura) y no solo la tabla, así la banda del encabezado y las
   rayas llegan hasta el borde en vez de dejar una franja vacía a la derecha. */
table.narrow{max-width:640px}
.table-wrap:has(> .tscroll > table.narrow){max-width:640px}
.table-wrap:has(> .tscroll > table.narrow) table.narrow{max-width:none}
.fig:has(> .table-wrap table.narrow){max-width:678px}
/* Fuentes: el dato no parte palabras; la fuente sí puede partir un código o dominio largo (32sa-8pi3,
   dolar.wilkinsonpc.com.co) cuando no cabe en el renglón; «enlace» va siempre entero, en una columna ceñida. */
table.sources td{overflow-wrap:break-word}
table.sources td:nth-child(2){overflow-wrap:anywhere}
table.sources td.ac{white-space:nowrap;width:1%}
.tnote{margin:0;padding:10px 14px;border-top:1px solid var(--line);font-size:12.5px;line-height:1.5;color:var(--muted)}
.grid2 > .table-wrap{margin:0;align-self:start}
.grid2.tab-aside{align-items:start}
.grid2.tab-aside > div > .note:first-child{margin-top:0}
/* Tabla con su apunte al lado: van en dos columnas mientras la tabla quepa (a 900 px aún sobra), y luego se apilan. */
@media (max-width:900px){.grid2.tab-aside{grid-template-columns:minmax(0,1fr)}}
/* Tablas dentro de una figura (Tabla A.1.1…): sin marco propio; la nota hace de pie de figura. */
.fig > .table-wrap{margin:8px 0 4px;border:0;border-radius:0}
.fig > .table-wrap > .tnote{padding:12px 2px 10px;margin-top:4px;font-size:13.5px;line-height:1.55;color:var(--ink-2)}
.fig > .table-wrap:has(> .tnote) + .cap{border-top:0;padding-top:0;margin-top:0}
/* Tabla B.3.1: tres grupos de pestañas (escenario, innovación, estrategia). Cada botón prende un marcador <i> y queda
   visible el panel cuyos data-a/b/c coinciden con los tres marcadores prendidos. */
.combo > .tabs{margin:6px 8px 8px 0}
.combo .tabs button{white-space:nowrap}
.combo > .cpane{display:none}
.combo > .cpane.on{display:block}
.combo > .cpane > .table-wrap{margin:0;border:0;border-radius:0}
@supports selector(:has(*)){
  .combo > .cpane{display:block}
  .combo:has(> i.on[data-a="0"]) > .cpane:not([data-a="0"]),.combo:has(> i.on[data-a="1"]) > .cpane:not([data-a="1"]),
  .combo:has(> i.on[data-a="2"]) > .cpane:not([data-a="2"]),.combo:has(> i.on[data-a="3"]) > .cpane:not([data-a="3"]),
  .combo:has(> i.on[data-b="0"]) > .cpane:not([data-b="0"]),.combo:has(> i.on[data-b="1"]) > .cpane:not([data-b="1"]),
  .combo:has(> i.on[data-b="2"]) > .cpane:not([data-b="2"]),.combo:has(> i.on[data-b="3"]) > .cpane:not([data-b="3"]),
  .combo:has(> i.on[data-c="0"]) > .cpane:not([data-c="0"]),.combo:has(> i.on[data-c="1"]) > .cpane:not([data-c="1"]),
  .combo:has(> i.on[data-c="2"]) > .cpane:not([data-c="2"]),.combo:has(> i.on[data-c="3"]) > .cpane:not([data-c="3"]){display:none}
}
/* Celular: las tablas de texto (stack) se vuelven una lista; cada fila es un bloque con el nombre de la columna al lado
   de cada dato. Las demás se desplazan de lado dentro de su marco, con la sombra como pista. */
@media (max-width:760px){
  .table-wrap.stack .tscroll{overflow:visible;background:none;-webkit-mask-image:none;mask-image:none}
  .table-wrap.stack::before,.table-wrap.stack::after{content:none}
  .table-wrap.stack table.data,.table-wrap.stack table.data tbody,.table-wrap.stack table.data tr{display:block;min-width:0 !important}
  .table-wrap.stack table.data thead{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}
  .table-wrap.stack table.data tr{padding:10px 0 12px}
  .table-wrap.stack table.data tr + tr{border-top:1px solid var(--line-2)}
  .table-wrap.stack table.data tr.hl{background:var(--hl)}
  .table-wrap.stack table.data td{display:grid;grid-template-columns:minmax(0,11.5em) minmax(0,1fr);column-gap:14px;align-items:baseline;
    padding:3px 14px;border:0;background:none;text-align:left;white-space:normal;font-size:13.5px}
  .table-wrap.stack table.data td::before{content:attr(data-label);font-size:12px;line-height:1.4;color:var(--muted)}
  .table-wrap.stack table.data td.tt{display:block;font-size:15px;line-height:1.35;padding:0 14px 6px}
  .table-wrap.stack table.data td.tt::before,.table-wrap.stack table.data td.eb::before{content:none}
  .table-wrap.stack table.data td.eb{display:block;padding:0 14px 3px;font-family:var(--f-mono);font-size:10.5px;letter-spacing:.1em;
    text-transform:uppercase;color:var(--brand)}
  .table-wrap.stack table.data td.eb b{color:inherit;font-weight:600}
  .table-wrap.stack table.data td.full{display:block;padding-top:6px;line-height:1.55}
  .table-wrap.stack table.data td.full::before{display:block;margin-bottom:1px}
  .table-wrap.stack table.data td:empty{display:none}
  .fig > .table-wrap.stack > .tnote{border-top:1px solid var(--line)}
  /* Fundamentales: indicador y valor en un renglón; fecha, presión y fuente en una línea pequeña debajo. */
  .table-wrap.stack table.fund tr{display:flex;flex-wrap:wrap;align-items:baseline;padding:9px 0 10px}
  .table-wrap.stack table.fund tr + tr:not(.sep){border-top-color:var(--line)}
  .table-wrap.stack table.fund tr::after{content:"";flex-basis:100%;order:3}
  .table-wrap.stack table.fund td{display:block;padding:0}
  .table-wrap.stack table.fund td::before{content:none}
  .table-wrap.stack table.fund td.eb{flex:1 1 100%;padding:0 14px 4px}
  .table-wrap.stack table.fund td.tt{flex:1 1 0;min-width:0;padding:0 10px 0 14px;font-size:14px;font-weight:500}
  .table-wrap.stack table.fund td:nth-child(3){flex:0 1 auto;max-width:52%;padding-right:14px;text-align:right;font-weight:600;
    text-wrap:balance}
  .table-wrap.stack table.fund td:nth-child(3) small{font-weight:500;color:var(--ink-2)}
  .table-wrap.stack table.fund td:nth-child(n+4){order:4;padding-top:3px;font-size:12px;color:var(--muted)}
  .table-wrap.stack table.fund td:nth-child(4){padding-left:14px}
  .table-wrap.stack table.fund td:nth-child(n+5)::before{content:"·";margin:0 .5em}
  /* Parámetros (kv): cada fila es un rótulo pequeño sobre su valor, en vez de una columna angosta de rótulos partidos. */
  table.kv,table.kv tbody,table.kv tr,table.kv td{display:block}
  table.kv thead{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}
  table.kv tr{padding:9px 0 10px}
  table.kv tr + tr{border-top:1px solid var(--line)}
  table.kv td,table.kv tbody tr:first-child td{border:0;padding:0 14px;background:none}
  table.kv td:first-child{width:auto;font-size:12px;font-weight:500;line-height:1.4;color:var(--muted);margin-bottom:2px}
}
@media print{
  .tscroll.vs{max-height:none !important;overflow:visible}
  .tscroll{-webkit-mask-image:none !important;mask-image:none !important}
  .table-wrap::before,.table-wrap::after{content:none}
  .tscroll.vs tfoot td::before{content:none}
}
.up,.down,.flat{font-weight:600;white-space:nowrap;font-size:12.5px}
.nw{white-space:nowrap}
.up{color:var(--verm)}
.down{color:var(--brand)}
.flat{color:var(--gold)}
.pill{display:inline-block;padding:2px 9px;border-radius:999px;font-size:12px;font-weight:600;background:var(--brand-tint);color:var(--brand)}

/* ---------- figuras */
.fig{background:var(--surface);border:1px solid var(--line);border-radius:10px;padding:16px 18px 6px;margin:26px 0;min-width:0}
.fig-label{font-family:var(--f-mono);font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);margin:0 2px 2px}
.fig-label b{color:var(--brand);font-weight:600}
.fig .cap{font-size:13.5px;line-height:1.55;color:var(--ink-2);padding:12px 2px 10px;margin-top:4px;border-top:1px solid var(--line)}
.fig .cap b{color:var(--ink)}
.plot-wrap{position:relative;min-width:0}
.plot{width:100%;min-width:0}
.js-plotly-plot .scrollbar-glyph{stroke:var(--muted)}
.plot:empty{background:repeating-linear-gradient(90deg,transparent 0 47px,var(--line) 47px 48px);opacity:.35;border-radius:6px}
.plot-controls{display:flex;flex-wrap:wrap;gap:8px;margin:8px 0 6px}
.seg{display:inline-flex;flex-wrap:wrap;gap:2px;padding:2px;background:var(--sunken);border-radius:8px;max-width:100%}
.seg button{font:inherit;font-size:12.5px;line-height:1.3;color:var(--ink-2);background:transparent;border:0;border-radius:6px;padding:5px 11px;cursor:pointer}
.seg button:hover{color:var(--ink)}
.seg button[aria-pressed="true"]{background:var(--surface);color:var(--ink);font-weight:500;box-shadow:0 0 0 1px var(--line),0 1px 2px rgba(0,0,0,.06)}
.seg-select{font:inherit;font-size:12.5px;color:var(--ink);background:var(--surface);border:1px solid var(--line-2);border-radius:8px;padding:5px 28px 5px 10px;
  appearance:none;-webkit-appearance:none;cursor:pointer;max-width:100%;
  background-image:linear-gradient(45deg,transparent 50%,var(--muted) 50%),linear-gradient(135deg,var(--muted) 50%,transparent 50%);
  background-position:calc(100% - 15px) 52%,calc(100% - 10px) 52%;background-size:5px 5px;background-repeat:no-repeat}
.js-plotly-plot .plotly .modebar{top:-2px !important}
.js-plotly-plot .plotly .modebar-btn svg{width:14px;height:14px}

/* ---------- piezas propias del informe */
.timeline{display:grid;grid-template-columns:repeat(10,minmax(0,1fr));gap:3px;margin:18px 0 8px;max-width:820px}
.timeline div{text-align:center;font-family:var(--f-mono);font-size:12px;padding:9px 2px;border-radius:4px;background:var(--sunken);color:var(--ink-2)}
.timeline div.h{background:var(--brand-2);color:#fff;font-weight:600}
.timeline-legend{font-size:13px;color:var(--muted);max-width:var(--measure)}
.tabs{display:inline-flex;flex-wrap:wrap;gap:2px;padding:2px;background:var(--sunken);border-radius:8px;margin:14px 0 6px}
.tabs button{font:inherit;font-size:13px;color:var(--ink-2);background:transparent;border:0;border-radius:6px;padding:6px 13px;cursor:pointer}
.tabs button.on{background:var(--surface);color:var(--ink);font-weight:500;box-shadow:0 0 0 1px var(--line)}
.tabpane{display:none}.tabpane.on{display:block}
.company{padding-top:18px}
.company h3{margin-top:2px;font-family:var(--f-display);font-size:24px;font-weight:600;font-variation-settings:"opsz" 14}
.toc-mobile{display:none}
footer{margin-top:56px;padding:26px 0 0;border-top:1px solid var(--line);font-size:13px;line-height:1.7;color:var(--muted)}

/* ---------- pantallas medianas y celulares */
@media (max-width:1180px){
  :root{--side:0px}
  .sidebar{width:min(320px,86vw);transform:translateX(-102%);visibility:hidden;transition:transform .22s ease,visibility 0s linear .22s;
    padding-top:max(22px,env(safe-area-inset-top,0px));padding-left:max(18px,env(safe-area-inset-left,0px))}
  body.nav-open .sidebar{transform:none;visibility:visible;transition:transform .22s ease;box-shadow:0 0 40px rgba(0,0,0,.22)}
  .scrim{display:block;position:fixed;inset:0;background:rgba(5,15,12,.42);z-index:25;opacity:0;pointer-events:none;transition:opacity .2s}
  body.nav-open .scrim{opacity:1;pointer-events:auto}
  .topbar{display:flex;position:sticky;top:0;z-index:20;align-items:center;gap:12px;justify-content:space-between;
    background:var(--surface);border-bottom:1px solid var(--line);padding-block:9px;
    padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}
